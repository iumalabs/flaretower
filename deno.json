{
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@fontsource/ibm-plex-sans": "npm:@fontsource/ibm-plex-sans@^5",
    "@fontsource/ibm-plex-mono": "npm:@fontsource/ibm-plex-mono@^5",
    "hono": "npm:hono@^4.13.0",
    "jose": "npm:jose@^6.2.8",
    "react": "npm:react@^19.2.8",
    "react/jsx-runtime": "npm:react@^19.2.8/jsx-runtime",
    "react/jsx-dev-runtime": "npm:react@^19.2.8/jsx-dev-runtime",
    "react-dom": "npm:react-dom@^19.2.8",
    "react-dom/client": "npm:react-dom@^19.2.8/client",
    "vite": "npm:vite@^8.2.0",
    "@cloudflare/vite-plugin": "npm:@cloudflare/vite-plugin@^1.51.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5",
    "wrangler": "npm:wrangler@^4.118.0",
    "@playwright/test": "npm:@playwright/test@^1.62.1",
    "@cloudflare/workers-types": "npm:@cloudflare/workers-types@^5.20260804.1",
    "@types/react": "npm:@types/react@^19.2.18",
    "@types/react-dom": "npm:@types/react-dom@^19.2.4"
  },
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "deploy": "deno task build && deno run -A npm:wrangler deploy --env production",
    "deploy:preview": "deno task build && deno run -A npm:wrangler versions upload --env preview",
    "test": "deno test -A tests/unit/",
    "test:e2e": "deno run -A npm:playwright test",
    "test:e2e:install": "deno run -A npm:playwright install --with-deps chromium",
    "db:migrations:apply:local": "deno run -A npm:wrangler d1 migrations apply flaretower-production --local --env production",
    "db:migrations:apply:remote": "deno run -A npm:wrangler d1 migrations apply flaretower-production --remote --env production",
    "db:migrations:apply:preview:local": "deno run -A npm:wrangler d1 migrations apply flaretower-preview --local --env preview",
    "db:migrations:apply:preview:remote": "deno run -A npm:wrangler d1 migrations apply flaretower-preview --remote --env preview",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@cloudflare/workers-types", "@types/react", "@types/react-dom"]
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "include": [
      "worker/",
      "app/",
      "tests/",
      "vite.config.ts",
      "README.md",
      "CLAUDE.md"
    ],
    "exclude": ["app/.vite/"]
  },
  "lint": {
    "include": [
      "worker/",
      "app/",
      "tests/",
      "vite.config.ts"
    ],
    "exclude": ["app/.vite/"]
  },
  "exclude": [
    ".wrangler/",
    "dist/",
    "node_modules/",
    "app/.vite/"
  ]
}
