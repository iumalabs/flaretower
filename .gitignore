# Secrets — never committed
.env
.env.*
# Exception: .env.development holds only CLOUDFLARE_ENV=preview (which
# Wrangler environment `deno task dev` targets locally) — not a credential,
# committed so local dev works out of the box (constitution Principle VIII
# only reserves secrecy for the API token itself).
!.env.development
.dev.vars

# Claude Code local-only state (credentials, local overrides)
.claude/settings.local.json

# Deno
.deno/

# Wrangler
.wrangler/
node_modules/

# Build output
dist/
.vite/
app/.vite/

# Test artifacts
coverage/
playwright-report/
test-results/

# Design package — local asset, not tracked in git (see constitution's
# Design System section); each contributor obtains it out-of-band.
docs/design.zip

# OS
.DS_Store
